## Draw output:
def get_activated_inputs(wildcards, step):
    inputs = []

    mapping = {"BUSTED": ["codon_alignments/{transcript_id}/HyPhy_output/{transcript_id}.busted_er.i_tree.tsv", 
                            "codon_alignments/{transcript_id}/HyPhy_output/{transcript_id}.busted_tree.i_tree.nh"],
               "MEME":  "codon_alignments/{transcript_id}/HyPhy_output/{transcript_id}.meme_mle.i_tree.tsv",
               "ABSREL": ["codon_alignments/{transcript_id}/HyPhy_output/{transcript_id}.absrel_er_i_tree.tsv",
               "codon_alignments/{transcript_id}/HyPhy_output/{transcript_id}.absrel_tree_i_tree.nh" ],
               "bayesCode": ["codon_alignments/{transcript_id}/tmp/{transcript_id}_classic.i_tree.ci0.025.tsv", 
                            "codon_alignments/{transcript_id}/tmp/{transcript_id}_mutsel.i_tree.ci0.025.tsv"],
                "RELAX": "codon_alignments/{transcript_id}/HyPhy_output/{transcript_id}.relax.i_tree.tsv"}
    
    for feature, path in mapping.items():
        if feature == step:
            #print(config["settings"]["selectionSettings"].get(feature))
            if config["settings"]["selectionSettings"].get(feature)["activate"]:
                inputs.append(path)
            
    return inputs

## Extract output tables from HyPhy Screens
use rule draw_output from standard as speciesTree_draw_output with:
