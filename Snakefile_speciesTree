## Run hyphy on species tree. Do this if species tree calculation is turned on in DEF.yaml: config['settings']['computeTree']['species_tree] == true
def get_input_ali_for_defined_tree_hyphy(wildcards):
    if config["settings"]["selectionSettings"]["doErrorCleaning"]:
        return "codon_alignments/{transcript_id}/tmp/{transcript_id}.busted.i_tree.filtered.fa"
    else:
        return get_input_for_busted(wildcards)

