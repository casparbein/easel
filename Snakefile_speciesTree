## Create the desired output files
def gather_input():
    all_input = []

    all_input.extend(expand("codon_alignments/{transcript_id}/done.txt", transcript_id = attempted))
    all_input.extend(expand("codon_alignments/{transcript_id}/tmp.cleaned", transcript_id = attempted))
    all_input.append("skipped_transcripts.tsv")
    all_input.extend(expand("codon_alignments/{transcript_id}/results.cleaned", transcript_id = attempted))
    all_input.extend(expand("codon_alignments/{transcript_id}/{transcript_id}.final.fa", transcript_id = attempted))
    #all_input.extend(expand("codon_alignments/{transcript_id}/{transcript_id}.cleaning.txt", transcript_id = attempted))

    return all_input

all_input = gather_input()

